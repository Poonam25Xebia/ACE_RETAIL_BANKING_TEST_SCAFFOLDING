# SCAFFOLD-SVC-001 environment variables (copy to .env for local use; never commit real values).
SERVER_PORT=8080
GRPC_SERVER_PORT=9090

# PostgreSQL (required)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=account_management
POSTGRES_USER=
POSTGRES_PASSWORD=

# MongoDB (optional, wired but unused)
MONGODB_URI=mongodb://localhost:27017/account_management

# Redis (optional, wired but unused)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka (optional, wired but unused)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
